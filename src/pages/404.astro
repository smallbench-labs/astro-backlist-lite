---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="container-x pt-16">
    <p class="label text-ink-2">Error 404</p>
    <h1 class="h1 mt-4">This page is out of print.</h1>
    <p class="lead mt-6 max-w-[48ch]">Nothing is published at this address.</p>
    <p class="mt-8"><a class="btn btn-ink" href="/">See every book on the list</a></p>
  </div>
</Base>
